{
  "name": "cc-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "hono": "^4",
    "ws": "^8"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^3"
  }
}
